{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/mechanism_interferometry_causality/schemas/active_tilt_input.schema.json",
  "title": "Mechanism Interferometry Active-Tilt Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["request", "candidates"],
  "properties": {
    "request": { "$ref": "#/$defs/request" },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "proposal_id",
        "primitive_id",
        "surviving_hypotheses",
        "planned_analysis",
        "source",
        "seed"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "proposal_id": { "$ref": "#/$defs/nonempty" },
        "primitive_id": { "$ref": "#/$defs/nonempty" },
        "surviving_hypotheses": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        },
        "planned_analysis": {
          "enum": ["four_law", "product_factorial"]
        },
        "source": { "$ref": "#/$defs/source" },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_revision",
        "source_kind",
        "model_family",
        "data_fingerprint",
        "assignment_unit_fingerprint",
        "fold_fingerprint",
        "hyperparameter_policy",
        "feature_flags"
      ],
      "properties": {
        "adapter_id": { "$ref": "#/$defs/nonempty" },
        "adapter_revision": { "$ref": "#/$defs/nonempty" },
        "source_kind": {
          "enum": [
            "preregistered_domain_model",
            "passive_learner",
            "previous_independent_audit",
            "exploratory_search"
          ]
        },
        "model_family": { "$ref": "#/$defs/nonempty" },
        "data_fingerprint": { "$ref": "#/$defs/nonempty" },
        "assignment_unit_fingerprint": { "$ref": "#/$defs/nonempty" },
        "fold_fingerprint": { "$ref": "#/$defs/nonempty" },
        "hyperparameter_policy": { "$ref": "#/$defs/nonempty" },
        "feature_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty" }
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "primitive_id",
        "measurable_delivery",
        "common_support",
        "design_eligibility",
        "predicted_pairwise_separations",
        "cost"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/$defs/nonempty" },
        "primitive_id": { "$ref": "#/$defs/nonempty" },
        "measurable_delivery": { "type": "boolean" },
        "common_support": { "type": "boolean" },
        "design_eligibility": { "$ref": "#/$defs/design_eligibility" },
        "predicted_pairwise_separations": {
          "type": "array",
          "items": { "$ref": "#/$defs/pairwise_separation" }
        },
        "cost": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        }
      }
    },
    "pairwise_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first", "second", "separation"],
      "properties": {
        "first": { "$ref": "#/$defs/nonempty" },
        "second": { "$ref": "#/$defs/nonempty" },
        "separation": { "type": "number", "minimum": 0 }
      }
    },
    "design_eligibility": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "not_required_for_four_law" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "audit_id"],
          "properties": {
            "status": { "const": "product_odds_verified" },
            "audit_id": { "$ref": "#/$defs/nonempty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "plan_id"],
          "properties": {
            "status": { "const": "reweighted_to_product" },
            "plan_id": { "$ref": "#/$defs/nonempty" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "const": "not_established" }
          }
        }
      ]
    }
  }
}

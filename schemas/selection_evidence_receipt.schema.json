{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/mechanism_interferometry_causality/schemas/selection_evidence_receipt.schema.json",
  "title": "Content-bound Selection Evidence Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "experiment_id",
    "manifest_canonical_sha256",
    "data_content_sha256",
    "declaration",
    "evidence_class",
    "authority_source_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "experiment_id": {"type": "string", "minLength": 1, "maxLength": 1024},
    "manifest_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "declaration": {"enum": ["state_independent_within_regime", "modeled"]},
    "evidence_class": {"enum": ["external_sampling_record", "validated_selection_model"]},
    "authority_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"declaration": {"const": "state_independent_within_regime"}}},
      "then": {"properties": {"evidence_class": {"const": "external_sampling_record"}}}
    },
    {
      "if": {"properties": {"declaration": {"const": "modeled"}}},
      "then": {"properties": {"evidence_class": {"const": "validated_selection_model"}}}
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/mechanism_interferometry_causality/schemas/evidence_finding.schema.json",
  "title": "Mechanism Interferometry Evidence Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "severity", "stage", "context"],
  "properties": {
    "code": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "severity": {"enum": ["info", "warning", "error"]},
    "stage": {"type": "string", "minLength": 1},
    "context": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}

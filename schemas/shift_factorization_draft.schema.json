{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/mechanism_interferometry_causality/schemas/shift_factorization_draft.schema.json",
  "title": "MIC Atlas Shift-Factorization Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "environments",
    "supports",
    "support_relations",
    "strategy_eligibility",
    "contract_requests",
    "next_queries"
  ],
  "properties": {
    "proposal_id": { "pattern": "^proposal_[0-9]{3,}$" },
    "environments": {
      "type": "array",
      "items": { "$ref": "shift_factorization_proposal.schema.json#/$defs/environment" }
    },
    "supports": {
      "type": "array",
      "items": { "$ref": "shift_factorization_proposal.schema.json#/$defs/support" }
    },
    "support_relations": {
      "type": "array",
      "items": { "$ref": "shift_factorization_proposal.schema.json#/$defs/relation" }
    },
    "strategy_eligibility": {
      "type": "object",
      "propertyNames": { "pattern": "^strategy_[0-9]{3,}$" },
      "additionalProperties": { "$ref": "shift_factorization_proposal.schema.json#/$defs/strategy" }
    },
    "contract_requests": {
      "type": "array",
      "items": { "$ref": "shift_factorization_proposal.schema.json#/$defs/contract_request" }
    },
    "next_queries": {
      "type": "array",
      "items": { "$ref": "shift_factorization_proposal.schema.json#/$defs/next_query" }
    }
  }
}

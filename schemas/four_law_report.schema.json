{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dicklesworthstone/mechanism_interferometry_causality/schemas/four_law_report.schema.json",
  "title": "Histogram four-law tabular diagnostic",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "gates",
    "preflight",
    "ingest",
    "information_content",
    "four_law",
    "projection",
    "ledger"
  ],
  "properties": {
    "schema_version": {"const": "2.1.0"},
    "experiment_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["abstained", "diagnostic_only"],
      "description": "Histogram four-law never issues passed or failed. A Passed value would launder a projection into a certificate."
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locality", "conditional_normalization", "square_flatness", "orientation"],
      "properties": {
        "locality": {"const": "unresolved"},
        "conditional_normalization": {"const": "unresolved"},
        "square_flatness": {"const": "unresolved"},
        "orientation": {"const": "unresolved"}
      },
      "description": "The histogram projection is diagnostic and establishes none of the theorem or orientation gates."
    },
    "preflight": {
      "type": "object",
      "required": ["manifest_canonical_sha256"],
      "properties": {
        "manifest_canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the validated manifest's canonical Rust serialization, not its source-file bytes."
        }
      }
    },
    "ingest": {
      "type": "object",
      "required": ["fingerprint", "regime_counts", "clusters_spanning_regimes", "missing_regimes"],
      "properties": {
        "fingerprint": {
          "type": "object",
          "required": ["content_sha256", "cluster_fingerprint", "n_rows", "n_included_clusters"],
          "properties": {
            "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "cluster_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "included_cluster_fingerprint": {"type": "string"},
            "resolved_path": {"type": "string"},
            "n_rows": {"type": "integer", "minimum": 0},
            "n_included_rows": {"type": "integer", "minimum": 0},
            "n_clusters": {"type": "integer", "minimum": 0},
            "n_included_clusters": {"type": "integer", "minimum": 0}
          }
        },
        "regime_counts": {"type": "array"},
        "clusters_spanning_regimes": {"type": "array", "items": {"type": "string"}},
        "missing_regimes": {"type": "array", "items": {"type": "string"}},
        "max_row_quota_gap": {"type": "number"},
        "max_cluster_quota_gap": {"type": "number"},
        "n_folds": {"type": "integer", "minimum": 1}
      }
    },
    "information_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "n_rows",
        "n_unit_labels",
        "units_are_rows",
        "n_distinct_supported_regimes",
        "n_complete_testable_squares",
        "units_per_corner_min",
        "units_per_corner_max",
        "confirmation_count_ready",
        "note"
      ],
      "properties": {
        "n_rows": {"type": "integer", "minimum": 0},
        "n_unit_labels": {"type": "integer", "minimum": 0},
        "units_are_rows": {"type": "boolean"},
        "n_distinct_supported_regimes": {"type": "integer", "minimum": 0},
        "n_complete_testable_squares": {"type": "integer", "minimum": 0},
        "units_per_corner_min": {"type": ["integer", "null"], "minimum": 0},
        "units_per_corner_max": {"type": ["integer", "null"], "minimum": 0},
        "confirmation_count_ready": {
          "type": "boolean",
          "description": "Count-only readiness; does not establish assignment-unit authority or an untouched confirmation split."
        },
        "note": {"type": "string", "minLength": 1}
      }
    },
    "four_law": {"type": "array"},
    "overlap": {"type": ["object", "null"]},
    "projection": {"type": "object"},
    "ledger": {
      "type": "object",
      "required": ["schema_version", "mode", "findings", "provenance"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "mode": {"enum": ["strict", "exploratory"]},
        "findings": {"type": "array"},
        "provenance": {"type": "object"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "information_content": {
            "properties": {"confirmation_count_ready": {"const": true}}
          }
        }
      },
      "then": {
        "properties": {
          "information_content": {
            "properties": {
              "n_complete_testable_squares": {"minimum": 1},
              "units_per_corner_min": {"type": "integer", "minimum": 2},
              "units_per_corner_max": {"type": "integer", "minimum": 2}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "information_content": {
            "properties": {
              "n_complete_testable_squares": {"minimum": 1},
              "units_per_corner_min": {"type": "integer", "minimum": 2}
            }
          }
        }
      },
      "then": {
        "properties": {
          "information_content": {
            "properties": {"confirmation_count_ready": {"const": true}}
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "diagnostic_only"}}},
      "then": {"properties": {"ledger": {"properties": {"mode": {"const": "exploratory"}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "abstained"}}},
      "then": {"properties": {"ledger": {"properties": {"mode": {"const": "strict"}}}}}
    }
  ]
}
